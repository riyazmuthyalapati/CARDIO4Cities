# Copy of .env values for Streamlit Cloud — paste into the app's Secrets UI
# (App -> Settings -> Secrets). Keys are uppercased into os.environ at startup.

# --- LLM providers ---
GROQ_API_KEY = ""
GOOGLE_API_KEY = ""
TAVILY_API_KEY = ""

# aicredits — paid OpenAI-compatible endpoint (extractor + fact-checker + Graphiti)
AICREDITS_API_KEY = ""
AICREDITS_BASE_URL = "https://aicredits.in/v1"
AICREDITS_MODEL = "google/gemini-2.5-flash-lite"
# Fact-checker MUST use a different family than AICREDITS_MODEL (structural independence)
AICREDITS_CHECKER_MODEL = "mistralai/mistral-small-3.2-24b-instruct"
AICREDITS_EMBEDDING_MODEL = "sentence-transformers/all-minilm-l6-v2"
AICREDITS_EMBEDDING_DIM = 384

# --- Datastores ---
DATABASE_URL = ""
QDRANT_URL = ""
QDRANT_API_KEY = ""
NEO4J_URI = ""
NEO4J_USER = "neo4j"
NEO4J_PASSWORD = ""
NEO4J_DATABASE = ""
