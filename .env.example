# Copy this file to .env and fill in your keys.
# .env is git-ignored — never commit real credentials.

# --- LLM providers ---
# https://console.groq.com/keys — free tier (30 RPM)
GROQ_API_KEY=
# https://aistudio.google.com/apikey — free tier (varies by model)
GOOGLE_API_KEY=

# aicredits — paid OpenAI-compatible endpoint. Extractor, fact-checker, and
# Graphiti (LLM + embeddings) all route here to avoid free-tier rate limits.
# The fact-checker MUST use a different family than AICREDITS_MODEL to keep
# the independent-fact-checker non-negotiable structural, not just prompted.
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://aicredits.in/v1
AICREDITS_MODEL=google/gemini-2.5-flash-lite
AICREDITS_CHECKER_MODEL=mistralai/mistral-small-3.2-24b-instruct
AICREDITS_EMBEDDING_MODEL=sentence-transformers/all-minilm-l6-v2
AICREDITS_EMBEDDING_DIM=384

# --- Web search ---
# https://app.tavily.com (1,000 free credits/month; DuckDuckGo fallback needs no key)
TAVILY_API_KEY=

# --- Relational: Supabase Postgres (https://supabase.com, free 500MB) ---
# Project Settings -> Database -> Connection string (URI, use the "session pooler" one)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres

# --- Vector: Qdrant Cloud (https://cloud.qdrant.io, free 1GB cluster) ---
QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=

# --- Graph: Neo4j AuraDB Free (https://console.neo4j.io) — backend for Graphiti ---
# AuraDB Free names the default DB after the instance ID, not "neo4j" — set NEO4J_DATABASE too.
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=
